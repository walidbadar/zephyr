config MSPI_ESP32
	bool "ESP32 MSPI driver"
	default y
	depends on DT_HAS_ESPRESSIF_ESP32_MSPI_ENABLED
	select PINCTRL
	select GPIO if $(dt_compat_any_has_prop,$(DT_COMPAT_ESPRESSIF_ESP32_MSPI),ce-gpios)
	select MSPI_DMA if $(dt_compat_any_has_prop,$(DT_COMPAT_ESPRESSIF_ESP32_MSPI),dma-enabled,True)
	help
	  Driver for the ESP32 general purpose SPI peripherals through the
	  MSPI API.

if MSPI_ESP32

config MSPI_ESP32_DMA_MAX_BUFFER_SIZE
	int "Longest DMA transaction (bytes)"
	default 4092
	range 64 4092
	help
	  Longest data phase the driver hands to the DMA in one transaction.
	  Longer packets are split into pieces with CS held between them.

config MSPI_ESP32_INTERRUPT
	bool "ESP32 MSPI interrupt mode"
	default y if $(dt_compat_any_has_prop,$(DT_COMPAT_ESPRESSIF_ESP32_MSPI),interrupts)
	help
	  Wait for the transaction done interrupt instead of polling, so that
	  other threads run while a transfer is in flight. Needs an interrupts
	  property on the controller node.

config MSPI_ESP32_PSRAM_DMA
	bool "Transfer directly out of PSRAM buffers"
	# SoCs whose GDMA can address PSRAM (SOC_PSRAM_DMA_CAPABLE)
	depends on ESP_SPIRAM && (SOC_SERIES_ESP32S3 || SOC_SERIES_ESP32P4 || \
		SOC_SERIES_ESP32C5 || SOC_SERIES_ESP32C61)
	help
	  Hand cache-line aligned PSRAM buffers to the DMA instead of copying
	  them into internal RAM first. PSRAM bandwidth is shared with
	  instruction fetch; when it cannot keep up with the bus clock the FIFO
	  underruns and the data is silently corrupted. Enable only at a bus
	  clock PSRAM sustains and verify the data.

endif # MSPI_ESP32
