if SOC_QCA9531

config NUM_IRQS
	default 32

config SYS_CLOCK_HW_CYCLES_PER_SEC
	default $(dt_node_int_prop_int,/cpus/cpu@0,clock-frequency)

configdefault UART_NS16550_ACCESS_WORD_ONLY
	default y

endif # SOC_QCA9531
